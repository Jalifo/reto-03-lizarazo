# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.

# Proveedor del modelo (implementado: anthropic)
LLM_PROVEEDOR=anthropic
# Clave del proveedor. Solo vive en el backend; nunca llega al front, a los logs ni a las respuestas.
ANTHROPIC_API_KEY=
# Modelo a usar
LLM_MODELO=claude-sonnet-5-5

# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=60000

# Opcional: protege el link público. Si se define, el chat pide esta clave.
APP_ACCESS_KEY=

PORT=3000
